<?xml version="1.0" encoding="utf-8"?>
<!--
  O prontuário guardado localmente fica FORA de backup em nuvem e de
  transferência entre aparelhos. É dado de saúde: ele existe neste aparelho
  porque o dono escolheu instalar o app, e não deve viajar sozinho para outro.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

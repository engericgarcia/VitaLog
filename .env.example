# ── Banco (Supabase) ────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string
#
# DATABASE_URL: use o "Transaction pooler" (porta 6543). É o que a Vercel usa
# em runtime serverless.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres"
#
# DIRECT_URL: use a conexão direta (porta 5432). Só as migrations usam — o
# pooler de transação não aceita os comandos DDL do drizzle-kit.
DIRECT_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ── Extração de laudos ──────────────────────────────────────────────────────
# Opcional: sem ela o app roda normalmente, só a tela /enviar fica indisponível.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""
